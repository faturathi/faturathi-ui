rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule to deny everything unauthenticated unless specified
    match /{document=**} {
      allow read, write: if true;
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    // Entities collection
    match /entities/{entityId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // VAT Groups collection
    match /vat_groups/{groupId} {
      allow read, write: if true;
    }

    // Audit logs collection
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
